# Configuracion inicial

```{r}
# Cargar librerias R
library(tidyverse)
library(ggplot2)
library(naniar)
library(mice)
library(corrplot)
library(here)

# Configuraciones
options(scipen = 999)
theme_set(theme_minimal())

# Cargar datos
datos_raw <- readRDS(here("data/datos_raw.rds"))
datos_median <- readRDS(here("data/datos_median.rds"))
datos_regresion<- readRDS(here("data/datos_regresion.rds"))
datos_mice <- readRDS(here("data/datos_mice.rds"))
datos_winsor <- readRDS(here("data/datos_winsor.rds"))

mostrar_grafico <- function(g)
{
  print(g)
}  




```

##Analisis exploratorio

```{r}
#| label: exploracion-inicial
#| fig.cap: "proporcion de valores faltantes por variables"
#| fig.width: 10
#| fig.height: 6

#resumen de datos
summary(datos_raw)

#Visualizacion de faltantes
mostrar_grafico(
  gg_miss_var(datos_raw) +
    labs(title = "Valores faltantes por variable") +
    theme_minimal()
)
```

##imputacion de datos \### comprobacion de metodos

```{r}
#| label: comparacion-imputacion
#| fig.width: 12
#| fig.height: 8

# Comparar distribuciones
par(mfrow = c(2,2))
hist(datos_raw$edad, main = "Original", col="lightblue")
hist(datos_median$edad, main = "Mediana", col="lightgreen")
hist(datos_regresion$edad, main = "Regresión", col="lightyellow")
hist(datos_mice$edad, main = "MICE", col="lightpink")
```

```{r}
#| label: exploracion-inicial
#| fig.cap: "proporcion de valores faltantes por variables"
#| fig.width: 10
#| fig.height: 6

#boxplot comparativo
boxplot(datos_mice$ingreso, datos_winsor$ingreso,
        names = c("Original", "winsorizado"),
        main = "Compraracion de Ingreso",
        col = c("lightblue", "lightgreen")
        )

```

